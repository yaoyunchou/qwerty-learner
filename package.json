  "scripts": {
    "dev": "bash scripts/with-node-path.sh node ./node_modules/vite/bin/vite.js",
    "start": "bash scripts/with-node-path.sh node ./node_modules/vite/bin/vite.js",
    "build": "bash scripts/with-node-path.sh node ./node_modules/cross-env/src/bin/cross-env.js CI=false node ./node_modules/vite/bin/vite.js build",
    "test": "echo \"No tests\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prepare": "husky install || true"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "bash scripts/with-node-path.sh node ./node_modules/eslint/bin/eslint.js --fix",
      "bash scripts/with-node-path.sh node ./node_modules/prettier/bin-prettier.js --write"
    ],
    "tests/**/*.{js,jsx,ts,tsx}": [
      "bash scripts/with-node-path.sh node ./node_modules/eslint/bin/eslint.js --fix",
      "bash scripts/with-node-path.sh node ./node_modules/prettier/bin-prettier.js --write"
    ],
    "{vite,playwright}.config.ts": [
      "bash scripts/with-node-path.sh node ./node_modules/eslint/bin/eslint.js --fix",
      "bash scripts/with-node-path.sh node ./node_modules/prettier/bin-prettier.js --write"
    ],
    "scripts/**/*.{js,cjs,mjs}": [
      "bash scripts/with-node-path.sh node ./node_modules/eslint/bin/eslint.js --fix",
      "bash scripts/with-node-path.sh node ./node_modules/prettier/bin-prettier.js --write"
    ],
    "{tailwind,postcss,prettier}.config.js": [
      "bash scripts/with-node-path.sh node ./node_modules/eslint/bin/eslint.js --fix",
      "bash scripts/with-node-path.sh node ./node_modules/prettier/bin-prettier.js --write"
    ],
    ".eslintrc.cjs": [
      "bash scripts/with-node-path.sh node ./node_modules/eslint/bin/eslint.js --fix",
      "bash scripts/with-node-path.sh node ./node_modules/prettier/bin-prettier.js --write"
    ],
    "**/*.{json,css,scss,md,yml,yaml}": [
      "bash scripts/with-node-path.sh node ./node_modules/prettier/bin-prettier.js --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@iconify/json": "^2.2.469",
    "@playwright/test": "^1.59.1",
    "@svgr/core": "^7.0.0",
