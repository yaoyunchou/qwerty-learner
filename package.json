    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "git-last-commit": "^1.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "postcss": "^8.5.13",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.8",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^3.4.19",
