# Frontend (Vite) — also add to Vercel Environment Variables (Production + Preview)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Local only (optional)
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Supabase Dashboard → Project Settings → API

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets)
# SUBMIT_API_KEY=your-random-api-key
# SUPABASE_SERVICE_ROLE_KEY=auto-injected when deployed on Supabase

# Legacy Vercel admin API (optional, if still using /api/admin/*)
# ADMIN_PASSWORD=your-admin-password
